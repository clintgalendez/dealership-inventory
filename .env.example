# Example configuration. No secrets here; never commit a real .env.

# --- Worker variables (local dev) -------------------------------------------
# Copy to .env (or .dev.vars) to override values from wrangler.jsonc when running
# `npm run dev` / `npm run preview`.
# Absolute session lifetime in seconds (default 28800 = 8h). Set low to demo expiry.
SESSION_TTL_SECONDS=60
# Release identifier shown by /api/health. The pipeline sets it to the commit SHA.
GIT_SHA=local

# --- Smoke test (`npm run smoke`, read from the shell environment) ----------
# BASE_URL=https://dealership-inventory.<your-subdomain>.workers.dev
# EXPECTED_VERSION=<commit sha that should be live>

# --- Deployment credentials (GitHub Actions repository secrets) -------------
# Set these in GitHub, not in a file:
# CLOUDFLARE_API_TOKEN=  (Workers Scripts: Edit + D1: Edit, scoped to the account)
# CLOUDFLARE_ACCOUNT_ID=
