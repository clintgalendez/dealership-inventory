{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dealership-inventory",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    // Serve the React SPA for unknown paths; only /api/* reaches the Worker first.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dealership-inventory",
      // Not a secret: the id is useless without an API token for the account.
      "database_id": "28469d5e-20bb-46ad-bb87-ab2ea2b648c0",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    // Absolute session lifetime. Lower it locally (.dev.vars) to demo expiry.
    "SESSION_TTL_SECONDS": "28800",
    // Overridden at deploy time with the commit SHA (wrangler deploy --var GIT_SHA:<sha>).
    "GIT_SHA": "local",
  },
  "observability": {
    "enabled": true,
  },
}
